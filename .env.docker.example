# Docker environment variables for Otterscan

# URL of the Erigon node with Otterscan patches
# This is the most important configuration - point it to your Erigon RPC endpoint
ERIGON_URL=http://host.docker.internal:8545

# Optional: Beacon chain API URL (for post-merge networks)
# BEACON_API_URL=http://host.docker.internal:5052

# Optional: Assets URL prefix (defaults to built-in assets)
# ASSETS_URL_PREFIX=http://localhost:5175

# Optional: Enable experimental features
# OTS2=true

# Optional: Disable config overwrite (if you want to use a custom config.json)
# DISABLE_CONFIG_OVERWRITE=true

# Optional: Custom port for API server (default: 3001)
# PORT=3001

# Optional: Custom port for Otterscan frontend (default: 80)
# OTTERSCAN_PORT=80
